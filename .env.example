# Speaker Diarization API Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Hugging Face Access Token
# ============================================
# Get your token from: https://huggingface.co/settings/tokens
# You must also accept the model conditions at:
#   - https://huggingface.co/pyannote/speaker-diarization-community-1
#   - https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
HUGGINGFACE_TOKEN=YOUR_HF_TOKEN_HERE

# ============================================
# Model Settings (optional - these are defaults)
# ============================================
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
# MODEL_CACHE_DIR=/app/models

# ============================================
# Qdrant Settings (optional - these are defaults)
# ============================================
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# COLLECTION_NAME=speaker_embeddings

# ============================================
# Processing Settings (optional)
# ============================================
# Device: auto (default), cuda, or cpu
# DEVICE=auto

# Speaker similarity threshold (0-1, default: 0.7)
# Higher = stricter matching, Lower = more permissive
# SIMILARITY_THRESHOLD=0.7

# Speaker count constraints (optional)
# MIN_SPEAKERS=1
# MAX_SPEAKERS=10

# Unload ML models after N idle seconds to free VRAM for co-hosted
# services (llama-swap etc.); they reload lazily on the next request.
# 0 = keep loaded forever.
# MODEL_IDLE_TIMEOUT=300

# ============================================
# API Settings (optional)
# ============================================
# API_HOST=0.0.0.0
# API_PORT=8000
# MAX_UPLOAD_SIZE=524288000  # 500MB
# UPLOAD_DIR=/app/uploads

# Shared secret required from LAN clients (empty/unset = auth disabled).
# Clients send it as "X-API-Key: <key>" or "Authorization: Bearer <key>".
# API_KEY=change-me

# ============================================
# ASR / STT Settings (optional)
# ============================================
# Enables /transcribe-diarized and /transcribe-identified endpoints.
# Requires an OpenAI-compatible ASR server. Two known-good options:
#
# Parakeet (default in docker-compose.yml — fast, native word timestamps,
# WAV-only so WHISPER_SEND_WAV must be true):
# WHISPER_API_URL=http://localhost:8081/v1
# WHISPER_MODEL=tdt-0.6b-v3
# WHISPER_SEND_WAV=true
#
# Whisper via a speaches container:
# WHISPER_API_URL=http://localhost:8000/v1
# WHISPER_MODEL=Systran/faster-whisper-large-v3
# WHISPER_SEND_WAV=false

# WHISPER_API_KEY=dummy
# WHISPER_LANGUAGE=  # Leave empty for auto-detect, or set to: en, es, fr, etc.
# WHISPER_TIMEOUT=300  # Timeout in seconds for long audio files
